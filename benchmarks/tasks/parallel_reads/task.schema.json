{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xcode.local/benchmarks/tool-scheduling-task.schema.json",
  "title": "Xcode tool scheduling benchmark task",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "workspace",
    "tool_workers",
    "operations"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"},
    "description": {"type": "string", "minLength": 1},
    "workspace": {"type": "string", "minLength": 1},
    "tool_workers": {"type": "integer", "minimum": 1},
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "path", "delay_ms"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
          },
          "kind": {"enum": ["read", "write"]},
          "path": {"type": "string", "minLength": 1},
          "delay_ms": {"type": "number", "minimum": 0},
          "content": {"type": "string"}
        }
      }
    }
  }
}
