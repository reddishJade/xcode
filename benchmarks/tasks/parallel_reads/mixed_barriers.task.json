    {"id": "read-02", "kind": "read", "path": "modules/module_02.py", "delay_ms": 100},
    {"id": "write-01", "kind": "write", "path": "output/probe.txt", "delay_ms": 100, "content": "first\n"},
    {"id": "write-02", "kind": "write", "path": "output/probe.txt", "delay_ms": 100, "content": "second\n"},
    {"id": "read-03", "kind": "read", "path": "modules/module_03.py", "delay_ms": 100},
    {"id": "read-04", "kind": "read", "path": "modules/module_04.py", "delay_ms": 100}
  ]
}
