{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xcode.local/benchmarks/long-horizon-task.schema.json",
  "title": "Xcode long-horizon benchmark task",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "workspace",
    "turns",
    "success_command"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"},
    "description": {"type": "string", "minLength": 1},
    "workspace": {"type": "string", "minLength": 1},
    "context_window": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fallback_recent_messages": {"type": "integer", "minimum": 1},
        "fallback_recent_tokens": {"type": "integer", "minimum": 1}
      }
    },
    "turns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["prompt"],
        "properties": {
          "prompt": {"type": "string", "minLength": 1},
          "rollover_before": {"type": "boolean"},
          "restart_after": {"type": "boolean"}
        }
      }
    },
    "success_command": {"$ref": "#/$defs/command"},
    "state_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "kind": {
            "enum": [
              "command_succeeds",
              "file_changed",
              "file_contains",
              "file_not_contains",
              "file_unchanged",
              "path_absent"
            ]
          },
          "path": {"type": "string", "minLength": 1},
          "value": {"type": "string"},
          "command": {"$ref": "#/$defs/command"}
        }
      }
    }
  },
  "$defs": {
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["argv"],
      "properties": {
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "timeout_seconds": {"type": "number", "exclusiveMinimum": 0}
      }
    }
  }
}
